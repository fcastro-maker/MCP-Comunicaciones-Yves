# Sitio de WordPress (con https, sin barra final)
WP_URL=https://greeninitiative.eco
# Usuario de WordPress y su contraseña de aplicación (Usuarios > Perfil > Contraseñas de aplicación)
WP_USUARIO=
WP_CLAVE_APP=
# Clave secreta del conector: va dentro de la dirección (/mcp/<clave>). Mínimo 24 caracteres al azar.
MCP_CLAVE=
# lectura | edicion | completo   (si falta, usa completo; si está mal escrito, usa lectura)
WP_NIVEL=completo
